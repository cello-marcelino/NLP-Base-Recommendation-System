# Application
APP_NAME=SiReDo
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
APP_URL=http://localhost:5000

# Authentication & Security
SECRET_KEY=change-this-in-production-secret-key
ADMIN_API_KEY=siredo-admin-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (Default: sqlite | Opsional: mysql)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/data/siredo.db

# Konfigurasi MySQL (hanya digunakan jika DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_siredo
DB_USERNAME=root
DB_PASSWORD=

# AI / LLM (Masa Depan: OpenAI / Gemini / Claude)
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

# Cache
CACHE_ENABLED=true

# Limits
MAX_BATCH_SIZE=100
MAX_K_RANK=20
