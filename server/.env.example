# Application Config
APP_NAME=SiReDo
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
SECRET_KEY=change-this-in-production-secret-key

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Security (API Key for administrative config changes)
ADMIN_API_KEY=siredo-admin-secret-key

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_siredo

# Limits
MAX_BATCH_SIZE=100
MAX_K_RANK=20
