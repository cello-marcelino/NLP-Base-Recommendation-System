# Backend Application Settings
APP_NAME=SiReDo
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5055
APP_URL=http://localhost:5055

# Authentication & Security
SECRET_KEY=change-this-in-production-secret-key
ADMIN_API_KEY=siredo-admin-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Logging Configuration
LOG_FILE=storage/logs/siredo.log
LOG_LEVEL=INFO

# Database Configuration (Driver Options: sqlite | mysql)
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/siredo.db

# MySQL Configuration (Used if DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_siredo
DB_USERNAME=root
DB_PASSWORD=

# Hardware Acceleration / NLP Device (Options: cpu | cuda | auto)
TORCH_DEVICE=cpu

# AI / LLM Provider Integration
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini

# Cache & Limits
CACHE_ENABLED=true
MAX_BATCH_SIZE=100
MAX_K_RANK=20
